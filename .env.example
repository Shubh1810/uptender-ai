# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (public; safe in the browser, RLS protects data) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL (auth redirects, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://tenderpost.org

# --- Supabase service role (SERVER ONLY, bypasses RLS) ---
# Used only to activate paid subscriptions after verifying payment.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (server only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks. URL: /api/razorpay/webhook, events: order.paid, payment.captured
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, or emails only reach your own Resend account.
EMAIL_FROM="TenderPost <hello@tenderpost.org>"
NOTIFICATION_EMAIL=sales@tenderpost.org
SALES_NOTIFICATION_EMAIL=sales@tenderpost.org

# --- Field encryption (server only) ---
# 32 random bytes, base64: openssl rand -base64 32
# Losing this key makes stored GST numbers unreadable. Keep it in a secret manager.
GST_ENCRYPTION_KEY=

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=

# --- Search engine verification (optional; tags are omitted when empty) ---
# Google Search Console > Add property > HTML tag > copy the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > Add site > HTML meta tag > copy the content="..." value
NEXT_PUBLIC_BING_SITE_VERIFICATION=
